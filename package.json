{
  "name": "docker-express",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docker_build": "docker build --rm -t docker-express .",
    "docker_run": "docker run --rm -v \"C:/docker_prod_env/config:/usr/src/app/config\" docker-express",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "eslintConfig": {
    "rules": {
      "json/no-empty-keys": "off"
    }
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "morgan": "~1.9.1"
  },
  "devDependencies": {
    "@eslint/css": "^0.10.0",
    "@eslint/js": "^9.31.0",
    "@eslint/json": "^0.13.0",
    "@eslint/markdown": "^7.0.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0"
  }
}
